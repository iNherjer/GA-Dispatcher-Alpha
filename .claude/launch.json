{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "GA Dispatcher",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["-e", "require('http').createServer((q,s)=>{const fs=require('fs'),path=require('path'),base='/Users/jofaist/Desktop/GA dispatcher alpha';let f=base+decodeURIComponent(q.url).split('?')[0];if(f.endsWith('/')||!f.includes('.'))f=base+'/index.html';try{const d=fs.readFileSync(f);const ext=f.split('.').pop();const mt={'html':'text/html','js':'application/javascript','css':'text/css','json':'application/json','png':'image/png','jpg':'image/jpeg'}[ext]||'application/octet-stream';s.writeHead(200,{'Content-Type':mt,'Access-Control-Allow-Origin':'*'});s.end(d);}catch(e){s.writeHead(404);s.end('Not found');}}).listen(8080,()=>console.log('Serving on 8080'))"],
      "port": 8080
    }
  ]
}
