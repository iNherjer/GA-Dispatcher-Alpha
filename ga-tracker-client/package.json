{
  "name": "ga-tracker-client",
  "version": "1.0.0",
  "description": "MSFS to WebSocket GPS Tracker Bridge",
  "main": "tracker.js",
  "scripts": {
    "start": "node tracker.js",
    "build:tracker": "pkg tracker.js --target node18-win-x64 --output VFR-Multitool-Tracker.exe",
    "smoke-test:edtw": "node spawn-edtw-smoke-test.js",
    "asset-scan": "node msfs-asset-scanner.js",
    "asset-validate": "node msfs-asset-validator.js",
    "build:smoke-test": "pkg spawn-edtw-smoke-test.js --target node20-win-x64 --output dist/edtw-smoke-test.exe",
    "build:asset-scanner": "pkg msfs-asset-scanner.js --target node18-win-x64 --output MSFS2024-Asset-Scanner.exe",
    "build:asset-validator": "pkg msfs-asset-validator.js --target node18-win-x64 --output MSFS2024-Asset-Validator.exe"
  },
  "pkg": {
    "scripts": "spawn-edtw-smoke-test.js",
    "assets": [],
    "targets": ["node20-win-x64"],
    "outputPath": "dist"
  },
  "dependencies": {
    "node-simconnect": "^4.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.18.1"
  }
}
